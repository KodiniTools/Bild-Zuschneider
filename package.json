{
  "name": "bild-zuschneider",
  "version": "0.1.0",
  "private": true,
  "description": "Bilder in verschiedenen Formaten direkt im Browser zuschneiden (KodiniTools)",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "vue-tsc && vite build",
    "type-check": "vue-tsc --noEmit && tsc -p e2e/tsconfig.json",
    "preview": "vite preview",
    "test": "vitest run",
    "test:unit": "vitest run --project unit",
    "test:browser": "vitest run --project browser",
    "test:watch": "vitest",
    "test:e2e": "playwright test",
    "lint": "eslint .",
    "lint:fix": "eslint . --fix",
    "lint:check": "eslint .",
    "format": "prettier --write .",
    "format:check": "prettier --check ."
  },
  "license": "MIT",
  "dependencies": {
    "pinia": "^2.3.1",
    "vue": "^3.5.45",
    "vue-router": "^4.6.4"
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "@playwright/test": "~1.63.0",
    "@types/node": "^22.20.5",
    "@vitejs/plugin-vue": "^5.2.4",
    "@vitest/browser": "^3.2.7",
    "@vue/eslint-config-typescript": "^14.9.0",
    "@vue/test-utils": "^2.5.1",
    "eslint": "^10.14.0",
    "eslint-config-prettier": "^10.1.8",
    "eslint-plugin-prettier": "^5.5.7",
    "eslint-plugin-vue": "^10.12.0",
    "globals": "^16.5.0",
    "happy-dom": "^20.14.6",
    "playwright": "~1.63.0",
    "prettier": "^3.9.10",
    "sass": "^1.108.0",
    "typescript": "~5.9",
    "vite": "^5.4.21",
    "vitest": "^3.2.7",
    "vue-eslint-parser": "^10.4.2",
    "vue-tsc": "^2.2.12"
  }
}
